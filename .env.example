DATABASE_URL="file:./dev.db"

# The consultant chat. Leave blank to run on graceful mock replies.
# Inference is the main variable cost per journey, so the two calls are split:
# the consultant is the product and gets a capable model; name enrichment is a
# few words of JSON and doesn't.
ANTHROPIC_API_KEY=""
NAMESAKE_MODEL="claude-sonnet-5"
NAMESAKE_ENRICH_MODEL="claude-haiku-4-5"

# Magic-link email. Leave RESEND_API_KEY blank in development and sign-in links
# are printed to the server console and offered as a button in the UI.
RESEND_API_KEY=""
NAMESAKE_FROM_EMAIL="Namesake <hello@yourdomain.com>"

# Only needed in production, where links can't be derived from the request
# origin (proxies, custom domains).
NAMESAKE_URL=""

# Payments. Leave STRIPE_SECRET_KEY blank in development and checkout routes to
# a local page that can simulate a successful payment; the moment a key is set,
# that page and its endpoint stop existing.
STRIPE_SECRET_KEY=""
# Required whenever STRIPE_SECRET_KEY is set — the webhook refuses anything it
# can't verify. Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=""

# Where boxed tiers can ship. Comma-separated ISO country codes.
NAMESAKE_SHIPPING_COUNTRIES="US,CA,GB,AU,NZ,IE"

# Who can see /admin/orders. Comma-separated emails; empty means nobody.
NAMESAKE_ADMIN_EMAILS=""

# Prices in cents. Defaults below; leave blank to use them.
#   Sprout $59 · Bloom $109 · Whole Journey $159 · self-serve $49 · extend $19
NAMESAKE_PRICE_SPROUT_CENTS=""
NAMESAKE_PRICE_BLOOM_CENTS=""
NAMESAKE_PRICE_WHOLE_JOURNEY_CENTS=""
NAMESAKE_PRICE_SELF_SERVE_CENTS=""
NAMESAKE_PRICE_EXTEND_CENTS=""
#   Add-ons: rattle $28 · blanket $58 · framed print $30
NAMESAKE_PRICE_RATTLE_CENTS=""
NAMESAKE_PRICE_BLANKET_CENTS=""
NAMESAKE_PRICE_FRAMED_PRINT_CENTS=""
