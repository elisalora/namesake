// Namesake — data model
// A short-term, collaborative baby-name journey for an expecting couple.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A real person, identified by a verified email address. One user can be a
/// parent in more than one journey (a second baby, a friend's space).
model User {
  id        String   @id @default(cuid())
  email     String   @unique // always stored lowercased
  name      String?
  createdAt DateTime @default(now())

  /// Free consultant turns this person has spent, ever, across every journey.
  ///
  /// A stored count rather than something derived from ChatMessage, and the
  /// difference matters. Derived, the query would have to be "messages this
  /// person wrote in journeys that nobody has paid for" — and the second half
  /// of that is *mutable*. Somebody who upgrades a journey would have its
  /// turns stop counting, handing them their free allowance back to spend
  /// somewhere else. Spending a free turn is a thing that happened; it is not
  /// a fact about the current state of a workspace.
  ///
  /// Only ever goes up, except when the consultant fails before saying a word
  /// — see `api/chat/route.ts`. There is no renewal, deliberately: renewal is
  /// the per-journey loophole with extra steps.
  freeTurnsUsed Int @default(0)

  members  Member[]
  sessions Session[]
}

/// A signed-in browser. The cookie carries the raw token; we only ever store
/// its SHA-256 hash, so a leaked database can't be replayed as a login.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A single-use magic link. Also hashed at rest.
///
/// `purpose` decides what redeeming it does:
///   signup — create the journey held in `payload`, with this email as owner
///   login  — sign an existing user back in
///   invite — bind this email to the Member seat named by `memberId`
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String // lowercased destination address
  purpose   String    @default("login") // signup | login | invite
  payload   String? // JSON journey draft, for signup
  memberId  String? // the seat being claimed, for invite
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// A paid access grant, and the record of the Stripe transaction behind it.
///
/// A journey can only come into existence by redeeming one of these, so the
/// purchase is the thing that's bought — not the workspace. That's what lets
/// gifting work without a second concept: a gift is simply a grant redeemed by
/// someone other than the person who paid for it.
///
///   journey — bought for yourself; `draft` holds the journey you described
///             before paying, and redeeming creates it
///   gift    — bought for someone else; they supply the journey details when
///             they redeem, so `draft` is null
///   extend  — pushes an existing workspace's window out; `workspaceId` is set
///             up front and there is nothing to redeem
model Purchase {
  id     String @id @default(cuid())
  tier   String // sprout | bloom | whole_journey | self_serve | extend
  kind   String // journey | gift | extend — how it's redeemed
  status String @default("pending") // pending | paid | redeemed

  /// How long it grants. `months` is fixed at purchase; `due_date_grace` can't
  /// be — a gifter rarely knows the due date — so it's resolved at redemption
  /// from the date the couple enters, falling back to `fallbackMonths`.
  expiryRule     String @default("months") // months | due_date_grace
  months         Int? // expiryRule = months
  graceDays      Int? // expiryRule = due_date_grace
  fallbackMonths Int? // expiryRule = due_date_grace, when no due date is given

  amountCents Int // total charged, tier plus any add-ons
  currency    String @default("usd")

  purchaserEmail String
  purchaserName  String?
  /// Optional on purpose: a boxed gift carries its redeem code on the card, so
  /// there may be no address to email it to.
  recipientEmail String?
  giftMessage    String?
  draft          String? // JSON journey draft, for `journey` purchases

  redeemCode  String  @unique // unguessable; the redeem link is the bearer token
  /// Reserved at purchase rather than at redemption, so the shower card can be
  /// printed and boxed before the journey it points at exists. Carried onto the
  /// workspace when the grant is redeemed.
  suggestSlug String? @unique
  workspaceId String? // extend: set at purchase. journey/gift: set on redeem.

  stripeSessionId String? @unique // also the idempotency key for fulfillment

  /// Physical fulfillment. Set when the tier ships a box or an add-on was
  /// bought; the address arrives from Stripe with the payment.
  needsShipping   Boolean   @default(false)
  shippingName    String?
  shippingAddress String? // JSON, as Stripe returned it
  fulfilledAt     DateTime?

  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  redeemedAt DateTime?

  items     PurchaseItem[]
  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([recipientEmail])
  @@index([needsShipping, fulfilledAt])
}

/// A line on a purchase — the tier itself, plus any add-ons. This is the
/// packing list: what actually has to go in the box.
model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  sku         String // tier id or add-on id
  name        String
  amountCents Int
  quantity    Int     @default(1)
  physical    Boolean @default(false)
  /// Keepsakes that can't be made until there's a name to put on them.
  shipsAfterNaming Boolean @default(false)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

/// The couple's private space — their "nest".
model Workspace {
  id          String    @id @default(cuid())
  babyLabel   String    @default("Baby") // e.g. "Baby Alora" or "Peanut"
  lastName    String? // family surname, used for initials + flow checks
  /// How many babies this journey has to name — 1, or 2 for twins, 3 for
  /// triplets. Everything downstream is counted against it: the decision is
  /// made once per baby, and the journey is only `decided` when every one of
  /// them has a name.
  babyCount   Int       @default(1)
  /// girl | boy | mixed | surprise | null. Steers the consultant and the
  /// default shortlist filter. "surprise" is a real answer, not a missing one,
  /// and "mixed" only means anything when there's more than one baby.
  expecting   String?
  dueDate     DateTime?
  status      String    @default("active") // active | decided | archived
  expiresAt   DateTime? // end of the paid window; null = grandfathered, no expiry
  /// Nobody has paid for this journey yet.
  ///
  /// A trial journey is complete except in three places: the consultant costs
  /// each parent one of their free turns, the printable shower card is closed,
  /// and so is the keepsake. Everything they write — shortlist, ratings, notes,
  /// the conversation itself — is theirs on a trial exactly as it is on a paid
  /// journey, and none of it is ever taken away.
  ///
  /// A flag rather than "are there any purchases attached", because there is
  /// exactly one function that applies a grant (`fulfillPurchase`) and one
  /// that creates a journey from one (`redeemPurchase`). Two writers, one
  /// answer, nothing to keep in sync — where the derived version would have to
  /// be recomputed correctly by every future reader.
  isTrial     Boolean   @default(false)
  suggestSlug String    @unique // public slug for the family suggestion link
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Who is mid-question with the consultant, and since when.
  ///
  /// One conversation, two people, and a reply that takes several seconds to
  /// arrive. Without this, both parents can ask at once and each reply gets
  /// composed from a transcript missing the other's question — then the two
  /// replies are stored in the order they *finished*, so one parent's answer
  /// ends up filed under the other's question. That wrong order is what every
  /// later turn reads back, so the conversation stays confused.
  ///
  /// A plain member id rather than a relation: it's a lock, not a fact about
  /// the journey, and it expires on its own. See lib/turn.ts.
  turnMemberId  String?
  turnStartedAt DateTime?

  members     Member[]
  names       NameEntry[]
  comments    Comment[]
  suggestions Suggestion[]
  messages    ChatMessage[]
  purchases   Purchase[]
}

/// A parent's seat in one journey. Two per workspace, typically.
///
/// A seat exists before its person does: the owner names their partner at the
/// start, and that seat sits empty (`userId` null) until the partner verifies
/// their email. `token` is the unguessable seat-claim link the owner can hand
/// over when they'd rather not type an address.
model Member {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String? // set once this person has verified their email
  name        String
  email       String? // where the invite was (or will be) sent
  color       String   @default("#c98ba5") // avatar tint
  token       String   @unique // per-seat claim link
  isOwner     Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  ratings   Rating[]
  comments  Comment[]
  messages  ChatMessage[]

  @@unique([workspaceId, userId])
  /// `Member_workspaceId_userId_key` starts with workspaceId, so a lookup by
  /// userId alone can't use it — and that lookup is on the sign-in path
  /// (`auth.ts`, the seat check) and on `/journeys`. Without this it is a
  /// sequential scan of every seat in the product, for every signed-in user.
  @@index([userId])
}

/// A candidate name on the shortlist.
///
/// The shortlist is one shared pool even for twins — a name isn't spoken for
/// until it's chosen, and parents weigh the whole list for both babies. Which
/// baby a name belongs to is therefore something the decision decides, not
/// something a candidate carries around.
///
/// Middle names are entries too, marked by `role`, rather than a second kind
/// of thing with its own table. A middle name gets weighed exactly like a
/// first one — hearts from both parents, notes, a veto, a meaning — and none
/// of that had to be built twice for it.
model NameEntry {
  id           String   @id @default(cuid())
  workspaceId  String
  /// first | middle — which part of the name this is a candidate for.
  role         String   @default("first")
  firstName    String
  /// A middle typed inline beside a first name, the way people say a name out
  /// loud ("Willow Alice"). Still supported, and used when no middle has been
  /// chosen from the middle list for that baby.
  middleName   String?
  lastName     String? // overrides workspace surname when set
  gender       String? // girl | boy | neutral
  origin       String?
  meaning      String?
  status       String   @default("considering") // considering | shortlist | vetoed | chosen
  source       String   @default("parent") // parent | suggestion | ai
  suggestionId String? // links back to the Suggestion it came from
  /// Set when this name is chosen: which baby it's for, 1-based, so slot 1 is
  /// Baby A. Null for every name still under consideration. Unique per
  /// workspace and role, so a baby has one first name and one middle name and
  /// no double tap can give them two.
  chosenSlot   Int?
  /// The story of why they chose it — one per baby, because with twins there
  /// are two stories and the keepsake should carry both.
  chosenReason String?
  /// The day they settled on it. Stamped once, when the name crosses into
  /// chosen, and cleared if they unpick it — coming back later to add a middle
  /// name or reword the story must not move it. The keepsake prints this date
  /// and people keep the printout, so it is a historical fact rather than a
  /// modification time. Null for names chosen before this column existed:
  /// nothing in the database recorded the day, and the keepsake omits the line
  /// rather than print a guess.
  chosenAt     DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ratings   Rating[]
  comments  Comment[]

  @@unique([workspaceId, role, chosenSlot])
  @@index([workspaceId, role])
}

/// One parent's feelings about one name: a heart score, and veto power.
model Rating {
  id         String   @id @default(cuid())
  nameId     String
  memberId   String
  score      Int      @default(0) // 0-5 hearts
  veto       Boolean  @default(false)
  vetoReason String?
  updatedAt  DateTime @updatedAt

  name   NameEntry @relation(fields: [nameId], references: [id], onDelete: Cascade)
  member Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([nameId, memberId])
}

/// A note on a name — from a parent, or carried in from a family suggestion.
model Comment {
  id          String   @id @default(cuid())
  workspaceId String
  nameId      String
  memberId    String? // null when the author is an outside suggester
  authorName  String // display name (parent's name or "Grandma Rose")
  body        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name      NameEntry @relation(fields: [nameId], references: [id], onDelete: Cascade)
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  /// Loaded nested under every name on the six-second dashboard poll.
  @@index([nameId])
  /// Not read by name, but a workspace being deleted cascades through here.
  @@index([workspaceId])
}

/// A name suggestion submitted by family/friends via the public link.
model Suggestion {
  id            String   @id @default(cuid())
  workspaceId   String
  suggestedName String
  suggesterName String
  relationship  String? // "Grandmother", "Best friend", ...
  reason        String? // the story behind the suggestion
  email         String? // optional, to notify them of the announcement
  status        String   @default("pending") // pending | imported | dismissed
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Both columns of the poll's query: which journey, newest first.
  @@index([workspaceId, createdAt])
}

/// The consultant conversation, per workspace (shared by both parents).
model ChatMessage {
  id          String   @id @default(cuid())
  workspaceId String
  memberId    String? // which parent spoke (null for assistant)
  role        String // user | assistant
  content     String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  /// Read three ways, all of them starting with the journey: the poll's
  /// newest 200, the consultant's newest 40, and the per-journey message
  /// count that enforces `NAMESAKE_MSG_CAP` on every single turn.
  @@index([workspaceId, createdAt])
}
